<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Forced dark theme: the Legendary UI is dark by design, regardless
         of the device's system light/dark setting. -->
    <style name="Theme.PrimeVidVault" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="colorSurface">@color/card</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
